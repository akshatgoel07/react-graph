# ──────────────────────────────────────────────────────────────────────────
# react-graph — local-first repo comprehension tool
# The ONLY external dependency is the Gemini API. Everything else runs in Docker.
# Copy this file to `.env` and fill in your Gemini key (or supply it per-session
# in the UI — BYOK; the key is never persisted server-side).
# ──────────────────────────────────────────────────────────────────────────

# Gemini (https://aistudio.google.com/apikey)
# Optional dev fallback. In normal use the key is entered in the UI per session.
GEMINI_API_KEY=

# Models (2026 GA defaults). gemini-2.0-flash is deprecated as of 2026-06-01.
GEMINI_CHAT_MODEL=gemini-2.5-flash
GEMINI_EMBED_MODEL=gemini-embedding-001
# gemini-embedding-001 emits 3072 dims by default; can be truncated. Must match
# the Qdrant collection dimension below.
EMBED_DIM=3072

# Internal service wiring (docker network names; don't change for local use)
QDRANT_URL=http://qdrant:6333
NATS_URL=nats://nats:4222

# The host directory that holds the repos you want to analyze. Mounted read-only
# into the worker at WORKSPACE_DIR. Point this at a folder of checkouts.
HOST_WORKSPACE=./workspace
WORKSPACE_DIR=/workspace

# Ports exposed on your machine
GATEWAY_PORT=8080
FRONTEND_PORT=3000

# Frontend -> gateway URL (browser side)
NEXT_PUBLIC_GATEWAY_URL=http://localhost:8080
